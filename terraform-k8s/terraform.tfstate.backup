            "upgrade_install": null,
            "values": [
              "metrics:\n  enabled: true\n  serviceMonitor:\n    enabled: true\n\ndbUser:\n  forcePassword: true\n  existingSecret: cassandra-key\n\n"
            ],
            "verify": false,
            "version": "12.1.3",
