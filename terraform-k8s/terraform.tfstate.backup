    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "cassandra_setup_cql",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "cassandra-setup.cql": "CREATE KEYSPACE IF NOT EXISTS money_keyspace\nWITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};\n\nCREATE TABLE IF NOT EXISTS money_keyspace.transactions (\n    transaction_id text,\n    sender_account text,\n    receiver_account text,\n    amount bigint,\n    timestamp timestamp,\n    sender_balance_before bigint,\n    receiver_balance_before bigint,\n    PRIMARY KEY (transaction_id)\n);\n"
            },
            "id": "streaming-pipeline/cassandra-setup-cql",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": null,
